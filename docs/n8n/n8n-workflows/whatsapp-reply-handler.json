{
  "name": "ENP - WhatsApp Reply Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-reply-handler",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "whatsapp-reply-handler"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-reply-match",
              "leftValue": "={{ $json.body.message_text }}",
              "rightValue": "^(sim|yes|quero|enviar?)\\s*$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000002",
      "name": "Is Teaser Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://seqgnxynrcylxsdzbloa.supabase.co/rest/v1/lead_interactions?lead_id=eq.{{ $json.body.lead_id }}&type=eq.whatsapp_sent&metadata->>template_name=eq.report_ready_teaser&created_at=gt.{{ $now.minus({hours: 48}).toISO() }}&select=*&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $credentials.supabaseAnonKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $credentials.supabaseServiceRoleKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000003",
      "name": "Check Teaser Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-teaser",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000004",
      "name": "Teaser Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://seqgnxynrcylxsdzbloa.supabase.co/functions/v1/send-whatsapp",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-secret",
              "value": "={{ $credentials.internalSecret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"lead_id\": \"{{ $('Webhook').item.json.body.lead_id }}\",\n  \"template_name\": \"report_ready_link\"\n}",
        "options": {}
      },
      "id": "c1b2c3d4-0003-4000-8000-000000000005",
      "name": "Send Report Link",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 140]
    },
    {
      "parameters": {},
      "id": "c1b2c3d4-0003-4000-8000-000000000006",
      "name": "No Action (No Teaser Found)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1260, 280]
    },
    {
      "parameters": {},
      "id": "c1b2c3d4-0003-4000-8000-000000000007",
      "name": "No Action (Regular Message)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [760, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Is Teaser Reply?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Teaser Reply?": {
      "main": [
        [
          {
            "node": "Check Teaser Sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Action (Regular Message)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Teaser Sent": {
      "main": [
        [
          {
            "node": "Teaser Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Teaser Found?": {
      "main": [
        [
          {
            "node": "Send Report Link",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Action (No Teaser Found)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "tags": [
