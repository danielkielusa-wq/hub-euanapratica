          "name": "Telegram API"
        }
      }
    },
    {
      "parameters": {},
      "id": "e1b2c3d4-0001-4000-8000-000000000012",
      "name": "Concluído",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2440, 380]
    },
    {
      "parameters": {
        "jsCode": "const resp = $input.item.json || {};\nconst errMsg = String(resp.error || resp.message || 'Erro desconhecido').replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\nconst message = [\n  '❌ *Falha na Geração do Relatório Semanal*',\n  '',\n  '*Erro:* ' + errMsg,\n  '',\n  'Verifique os logs em:',\n  'Supabase → Edge Functions → generate\\-weekly\\-report → Logs'\n].join('\\n');\nreturn [{ json: { message } }];"
      },
