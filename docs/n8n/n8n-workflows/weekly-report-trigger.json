          "parse_mode": "MarkdownV2"
        }
      },
      "id": "e1b2c3d4-0001-4000-8000-000000000011",
      "name": "Telegram — Alertas Críticos",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2220, 300],
      "credentials": {
