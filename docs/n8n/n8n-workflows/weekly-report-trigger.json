      "id": "e1b2c3d4-0001-4000-8000-000000000009",
      "name": "Tem Alertas Críticos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1780, 380]
    },
    {
      "parameters": {
        "jsCode": "const criticals = $input.item.json.criticals || [];\nconst lines = criticals.map(a => {\n  const title = String(a.title || '').replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\n  const desc = String(a.description || '').replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\n  return '🚨 *' + title + '*\\n' + desc;\n}).join('\\n\\n');\nconst message = '🚨 *ALERTAS CRÍTICOS — Ação Imediata*\\n\\n' + lines;\nreturn [{ json: { message } }];"
      },
      "id": "e1b2c3d4-0001-4000-8000-000000000010",
      "name": "Formatar Alertas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
