{
  "name": "E2E Tests - Daily Report",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "e2e-results",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook E2E Results",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "e2e-results"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-passed",
              "leftValue": "={{ $json.body.status }}",
              "rightValue": "passed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-passed",
      "name": "Tests Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "subject-success",
              "name": "emailSubject",
              "value": "=✅ E2E OK — {{ $json.body.summary.passed }}/{{ $json.body.summary.total }} testes passaram",
              "type": "string"
            },
            {
              "id": "body-success",
              "name": "emailBody",
              "value": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #10b981, #059669); border-radius: 12px; padding: 24px; color: white; text-align: center; margin-bottom: 20px;\">\n    <h1 style=\"margin: 0; font-size: 28px;\">✅ Testes E2E Passaram</h1>\n    <p style=\"margin: 8px 0 0; opacity: 0.9; font-size: 16px;\">EU na Pratica Hub</p>\n  </div>\n\n  <div style=\"background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px; padding: 20px; margin-bottom: 16px;\">\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">Total de testes</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right; color: #059669;\">{{ $json.body.summary.total }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">Passaram</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right; color: #059669;\">{{ $json.body.summary.passed }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">Duracao</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right; color: #059669;\">{{ $json.body.summary.duration_seconds }}s</td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; margin-bottom: 16px;\">\n    <p style=\"margin: 0; font-size: 13px; color: #6b7280;\">Branch: <strong>{{ $json.body.metadata.branch }}</strong> | Commit: <strong>{{ $json.body.metadata.commit }}</strong></p>\n    <p style=\"margin: 8px 0 0; font-size: 13px; color: #6b7280;\">{{ $json.body.metadata.timestamp }}</p>\n  </div>\n\n  <a href=\"{{ $json.body.metadata.run_url }}\" style=\"display: block; text-align: center; background: #059669; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px;\">Ver Relatorio no GitHub</a>\n</div>",
              "type": "string"
            },
            {
              "id": "telegram-success",
              "name": "telegramMessage",
              "value": "=✅ *E2E Tests — Tudo OK*\n\n*{{ $json.body.summary.passed }}* de *{{ $json.body.summary.total }}* testes passaram em *{{ $json.body.summary.duration_seconds }}s*\n\nBranch: `{{ $json.body.metadata.branch }}` | Commit: `{{ $json.body.metadata.commit }}`\n\n[Ver relatorio]({{ $json.body.metadata.run_url }})",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-success",
      "name": "Format Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 180]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "subject-fail",
              "name": "emailSubject",
              "value": "=❌ E2E FALHOU — {{ $json.body.summary.failed }}/{{ $json.body.summary.total }} testes falharam",
              "type": "string"
            },
            {
              "id": "body-fail",
              "name": "emailBody",
              "value": "=<div style=\"font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 12px; padding: 24px; color: white; text-align: center; margin-bottom: 20px;\">\n    <h1 style=\"margin: 0; font-size: 28px;\">❌ Testes E2E Falharam</h1>\n    <p style=\"margin: 8px 0 0; opacity: 0.9; font-size: 16px;\">EU na Pratica Hub — Acao necessaria</p>\n  </div>\n\n  <div style=\"background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 20px; margin-bottom: 16px;\">\n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">Total de testes</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right;\">{{ $json.body.summary.total }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">✅ Passaram</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right; color: #059669;\">{{ $json.body.summary.passed }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">❌ Falharam</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right; color: #dc2626;\">{{ $json.body.summary.failed }}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; font-size: 14px; color: #374151;\">Duracao</td>\n        <td style=\"padding: 8px 0; font-size: 20px; font-weight: bold; text-align: right;\">{{ $json.body.summary.duration_seconds }}s</td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px; padding: 20px; margin-bottom: 16px;\">\n    <h3 style=\"margin: 0 0 12px; color: #dc2626; font-size: 16px;\">Falhas Encontradas:</h3>\n    {{ $json.body.failures.map(f => '<div style=\"background: white; border: 1px solid #fecaca; border-radius: 8px; padding: 12px; margin-bottom: 8px;\"><strong style=\"color: #dc2626;\">' + f.name + '</strong><br/><span style=\"font-size: 13px; color: #6b7280;\">' + f.suite + '</span><br/><code style=\"background: #fef2f2; padding: 2px 6px; border-radius: 4px; font-size: 12px; color: #991b1b;\">' + f.error.substring(0, 200) + '</code></div>').join('') }}\n  </div>\n\n  <div style=\"background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; margin-bottom: 16px;\">\n    <p style=\"margin: 0; font-size: 13px; color: #6b7280;\">Branch: <strong>{{ $json.body.metadata.branch }}</strong> | Commit: <strong>{{ $json.body.metadata.commit }}</strong></p>\n    <p style=\"margin: 8px 0 0; font-size: 13px; color: #6b7280;\">{{ $json.body.metadata.timestamp }}</p>\n  </div>\n\n  <a href=\"{{ $json.body.metadata.run_url }}\" style=\"display: block; text-align: center; background: #dc2626; color: white; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px;\">Ver Detalhes no GitHub</a>\n</div>",
              "type": "string"
            },
            {
              "id": "telegram-fail",
              "name": "telegramMessage",
              "value": "=❌ *E2E Tests — FALHAS DETECTADAS*\n\n*{{ $json.body.summary.failed }}* de *{{ $json.body.summary.total }}* testes falharam\n\n*Falhas:*\n{{ $json.body.failures.map(f => '- ' + f.name + ': ' + f.error.substring(0, 80)).join('\\n') }}\n\nBranch: `{{ $json.body.metadata.branch }}` | Commit: `{{ $json.body.metadata.commit }}`\n\n[Ver relatorio]({{ $json.body.metadata.run_url }})",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-failure",
      "name": "Format Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 420]
    },
    {
      "parameters": {
        "sendTo": "kiel.daniel@gmail.com",
        "subject": "={{ $json.emailSubject }}",
        "emailType": "html",
        "html": "={{ $json.emailBody }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "email-success",
      "name": "Email Sucesso",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 120],
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_SEU_SMTP",
          "name": "SMTP (configure nas credentials)"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "kiel.daniel@gmail.com",
        "subject": "={{ $json.emailSubject }}",
        "emailType": "html",
        "html": "={{ $json.emailBody }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "email-failure",
      "name": "Email Falha",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 360],
      "credentials": {
        "smtp": {
          "id": "CONFIGURE_SEU_SMTP",
          "name": "SMTP (configure nas credentials)"
        }
      }
    },
    {
      "parameters": {
        "chatId": "",
        "text": "={{ $json.telegramMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "telegram-success",
      "name": "Telegram Sucesso",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 220],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_SEU_BOT",
          "name": "Telegram Bot (configure nas credentials)"
        }
      }
    },
    {
      "parameters": {
        "chatId": "",
        "text": "={{ $json.telegramMessage }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "telegram-failure",
      "name": "Telegram Falha",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 480],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_SEU_BOT",
          "name": "Telegram Bot (configure nas credentials)"
        }
      }
    }
  ],
  "connections": {
