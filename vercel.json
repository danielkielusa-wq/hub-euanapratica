{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/vaga/:id",
      "destination": "/api/og-job?id=:id"
    },
    {
      "source": "/live/:slug",
      "destination": "/api/og-live?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
